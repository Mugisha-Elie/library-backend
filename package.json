{
  "name": "library-backend",
  "version": "1.0.0",
  "description": "Library Management API built with NestJS, pg=promise, and layered architecture",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint \"{src,test}/**/*.ts\"",
    "lint:prettier": "prettier --check \"{src,test}/**/*.{ts,json}\"",
    "lint": "npm run lint:tsc && npm run lint:eslint && npm run lint:prettier",
    "test": "npm run lint && npm run test:jest",
    "test:jest": "jest --coverage",
    "test:watch": "jest --watch",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "migrate:up": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate -m migrations up",
    "migrate:down": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate -m migrations down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mugisha-Elie/library-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mugisha-Elie/library-backend/issues"
  },
  "homepage": "https://github.com/Mugisha-Elie/library-backend#readme",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pg-promise": "^12.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "type-fest": "^5.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
